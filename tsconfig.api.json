{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/api",
    "module": "Node16",
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "target": "ES2021",
    "moduleResolution": "Node16",
    "strict": false
  },
  "include": [
    "api/**/*"
  ]
}